# Builds Digup Run Mac (Apple Silicon) DMG on GitHub Actions — unsigned / ad-hoc for first betas.
# Signed+notarized DMGs still need a Mac with Developer ID (scripts/release.sh).
# Dispatch: gh workflow run macos.yml
name: macOS

on:
  workflow_dispatch:
    inputs:
      ref:
        description: Branch or tag to build
        default: main

permissions:
  contents: read

jobs:
  macos:
    runs-on: macos-14
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          ref: ${{ inputs.ref }}

      - name: Select Xcode
        run: |
          # Prefer newest installed Xcode (Swift 6.2+ as upstream expects).
          sudo xcode-select -s /Applications/Xcode.app/Contents/Developer
          xcodebuild -version
          swift --version

      - name: CMake (llama.cpp)
        run: brew install cmake ninja || true

      - name: Build unsigned DMG
        run: scripts/package-macos-ci.sh

      - uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        with:
          name: DigupRun-macos-arm64
          path: build.noindex/release/DigupRun-*-macos-arm64.dmg
